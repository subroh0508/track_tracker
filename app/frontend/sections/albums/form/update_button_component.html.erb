<div class="<%= classes %>"
  role="group"
>
  <%= render Button::Component.new(
    variant: Button::CONTAINED,
    shape: Button::SQUARE,
    type: "submit",
    form_method: :put,
    form_action: form_action(id),
    classes: primary_button_classes,
  ) do %>
    <%= t("common.update") %>
  <% end %>
  <%= render Dropdown::Component.new(
    anchor: Dropdown::Anchor::RIGHT_BOTTOM,
    button_classes: dropdown_button_classes,
    dropdown_classes: "w-68 -translate-x-60.5",
    classes: "h-full",
  ) do |component| %>
    <% component.with_button do %>
      <%= render Icon::CaretDown.new %>
    <% end %>
    <% component.with_item do %>
      <%= render Dropdown::ButtonComponent.new(
        type: "submit",
        shape: Button::SQUARE,
        form_method: :put,
        form_action: form_action(id, Api::SPOTIFY),
      ) do %>
        <%= t("albums.edit.update_all_by_spotify") %>
      <% end %>
    <% end %>
    <% component.with_item do %>
      <%= render Dropdown::ButtonComponent.new(
        type: "submit",
        shape: Button::SQUARE,
        form_method: :put,
        form_action: form_action(id, Api::APPLE_MUSIC),
      ) do %>
        <%= t("albums.edit.update_all_by_apple_music") %>
      <% end %>
    <% end %>
  <% end %>
</div>
